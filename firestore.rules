rules_version = '2';
// Gunnadoo Command Centre — security rules.
// Paste this whole file into: Firebase console > Firestore Database > Rules > Publish.
// EDIT the two owner emails below (lower case) so they match firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmails() { return ['damschneider@hotmail.com', 'c_micko17@hotmail.com']; }

    function signedIn()   { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail()    { return request.auth.token.email.lower(); }
    function isOwner()    { return signedIn() && myEmail() in ownerEmails(); }
    function profilePath(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function role()       { return get(profilePath()).data.role; }
    function isAdmin()    { return isOwner() || (hasProfile() && role() == 'admin'); }
    function isMember()   { return isOwner() || hasProfile(); }
    function canWork()    { return isAdmin() || (hasProfile() && role() == 'staff'); }
    function isHistoryEditor() { return signedIn() && myEmail() == 'damschneider@hotmail.com'; }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }

    // Who is allowed to join, and with what role. Admins manage these.
    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && myEmail() == inviteEmail);
      allow write: if isAdmin();
    }

    // One profile per person. Created on first login from their invite.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && (
             (isOwner() && request.resource.data.role == 'admin')
          || (exists(invitePath()) && request.resource.data.role == get(invitePath()).data.role)
        );
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Homepage link tiles. Each tile lists which roles can see it.
    match /tiles/{id} {
      allow read: if isAdmin() || (hasProfile() && role() in resource.data.roles);
      allow write: if isAdmin();
    }

    // ---- Harvest Grain Tracker ----
    // Loads in and out: everyone sees them, staff + admin add/edit, only admin deletes.
    match /grain_deliveries/{id} {
      allow read: if isMember();
      allow create, update: if canWork();
      allow delete: if isAdmin();
    }
    match /grain_outloads/{id} {
      allow read: if isMember();
      allow create, update: if canWork();
      allow delete: if isAdmin();
    }
    // Storage/paddock/grade dropdown lists: staff can add new options.
    match /grain_lists/{id} {
      allow read: if isMember();
      allow write: if canWork();
    }
    // Contracts and settings: everyone can read (staff pick a contract on a load), only admin changes.
    match /grain_contracts/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /grain_settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Prices: admin only, never visible to staff or family.
    match /grain_pricing/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Chemical Costs ----
    // Product names + label facts: everyone can read (spray safety), admin edits.
    match /chem_products/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /chem_labels/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Purchases and costs: admin only.
    match /chem_purchases/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Gunnadoo Workshop ----
    // Machines: everyone reads; staff can log jobs (updates hours, last-service dates, adds parts); admin deletes.
    match /workshop_machines/{id} {
      allow read: if isMember();
      allow create, update: if canWork();
      allow delete: if isAdmin();
    }
    // History: staff log jobs and can tick "Mark fixed"; only Damo can edit or delete entries.
    match /workshop_logs/{id} {
      allow read: if isMember();
      allow create: if canWork();
      allow update: if isHistoryEditor()
        || (canWork() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedDate']));
      allow delete: if isHistoryEditor();
    }
    // Farm oils and photos: everyone reads, admin changes.
    match /workshop_oils/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /workshop_photos/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Machinery register + service history (old built-in section, no longer on the homepage).
    match /machines/{id} {
      allow read: if isMember();
      allow create, update: if canWork();
      allow delete: if isAdmin();

      match /services/{sid} {
        allow read: if isMember();
        allow create, update: if canWork();
        allow delete: if isAdmin();
      }
    }
  }
}
